# Copy to .env.local and fill in. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> "Secret key" (sb_secret_...)
SUPABASE_SECRET_KEY=

# Google AI Studio -> Get API key. Server-only.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash
GEMINI_MODEL=

# Optional. Needed only for private repositories and for higher GitHub rate limits
# (5,000/hour instead of 60/hour). Use a fine-grained, READ-ONLY token limited to the
# repositories you need: "Contents: Read" and "Metadata: Read". Server-only.
GITHUB_TOKEN=

# Local text-extraction service for assignment submissions (see extractor/README.md). Server-only.
# EXTRACTOR_URL defaults to http://127.0.0.1:8001. EXTRACTOR_KEY is a long random secret shared with the service;
# the service also reads it from this file, so you only set it here.
EXTRACTOR_URL=http://127.0.0.1:8001
EXTRACTOR_KEY=

# Workflow (LangGraph) checkpoints. Server-only. The restricted Postgres role "langgraph_app" from migration 0009,
# through Supabase's transaction pooler (Dashboard, Connect). Change the pooler URL's user prefix "postgres." to
# "langgraph_app." and use the password you set for that role:
#   postgresql://langgraph_app.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=
# Supabase's public CA certificate, downloaded from Database settings, SSL configuration. Defaults to certs/supabase-ca.crt
DATABASE_CA_PATH=
